---
import Layout from '../layouts/Layout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import Intro from '../components/Intro.astro';
import Highlights from '../components/Highlights.astro';
import ProjectList from '../components/ProjectList.astro';
import WritingList from '../components/WritingList.astro';
import MusicList from '../components/MusicList.astro';
import WorkList from '../components/WorkList.astro';
---

<Layout>
  <section
    aria-labelledby="profile-name"
    class="page-shell relative mx-auto max-w-[34.375rem] pt-16 pb-8 sm:pt-20"
  >
    <ProfileHeader />
    <Intro />
  </section>
  <Highlights />
  <ProjectList />
  <WritingList />
  <MusicList />
  <WorkList />
</Layout>
