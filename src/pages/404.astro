---
import Layout from '../layouts/Layout.astro';
import { NotFound } from '../components/react/NotFound';
---

<Layout title="404" footerLess>
  <section class="page-shell mx-auto flex min-h-dvh max-w-[34.375rem] flex-col items-start justify-center py-20">
    <p class="text-ink-muted mb-6 font-mono text-[10px] tracking-[0.14em] uppercase">Error / 404</p>
    <NotFound client:load />
  </section>
</Layout>
