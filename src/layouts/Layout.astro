---
import '../styles/global.css';
import { Font } from 'astro:assets';
import SiteMeta from '../components/SiteMeta.astro';
import Footer from '../components/Footer.astro';
import InkTrail from '../components/InkTrail.astro';
import SmoothScroll from '../components/SmoothScroll.astro';

interface Props {
  title?: string;
  footerLess?: boolean;
}

const { title, footerLess = false } = Astro.props;
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-caveat" preload />
    <meta name="theme-color" content="#0d0d0c" />
    <meta name="msapplication-TileColor" content="#0d0d0c" />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#0d0d0c" />
    <SiteMeta pageTitle={title} />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased">
    <InkTrail />
    <main id="main-content" class="relative z-[1]">
      <slot />
    </main>
    {!footerLess && <Footer />}
    <SmoothScroll />
    <script is:inline async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>
