---
import { getCollection } from 'astro:content';
import { ProjectRows, type ProjectRow } from './react/ProjectRows';
import SectionTitle from './SectionTitle.astro';

const creations = (await getCollection('creations')).sort((a, b) => b.data.date - a.data.date);

const projects: ProjectRow[] = creations.map(({ id, data }) => ({
  id,
  title: data.title,
  description: data.body,
  year: data.date,
  url: data.url ? (data.url.startsWith('http') ? data.url : `https://${data.url}`) : undefined,
  github: data.github,
  badge: data.badge,
  status: data.status,
}));
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class="page-shell mx-auto max-w-[34.375rem] py-8 sm:py-10"
>
  <div class="mb-4">
    <SectionTitle id="projects-title">Projects</SectionTitle>
  </div>
  <ProjectRows client:visible projects={projects} />
</section>
