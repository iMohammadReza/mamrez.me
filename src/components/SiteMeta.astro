---
import { moreProfiles, socials } from '../lib/site';

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;

const author = 'MohammadReza Iranmanesh';
const description =
  'MohammadReza Iranmanesh (MamRez) — full-stack product engineer building AI product surfaces, design systems and side projects. Portfolio, work and writing.';
const fullTitle = pageTitle ? `${pageTitle} - ${author}` : author;
const image = `${Astro.site}favicon/apple-touch-icon.png`;
const twitterId = '@notmamrez';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<title>{fullTitle}</title>

<link rel="canonical" href={canonicalUrl} />

<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta
  name="keywords"
  content="MohammadReza, Iranmanesh, MamRez, UncleMamrez, Uncle Mamrez, portfolio, resume, product engineer, full-stack, frontend, react, typescript, AI"
/>

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={image} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:site:id" content={twitterId} />
<meta name="twitter:creator" content={twitterId} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{!pageTitle && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${Astro.site}#website`,
          url: Astro.site,
          name: author,
          description,
          publisher: { '@id': `${Astro.site}#person` },
        },
        {
          '@type': 'Person',
          '@id': `${Astro.site}#person`,
          name: author,
          url: Astro.site,
          sameAs: [
            ...socials.filter((s) => !s.href.startsWith('mailto:')).map((s) => s.href),
            ...moreProfiles,
          ],
          jobTitle: 'Full-Stack Product Engineer',
        },
      ],
    })}
  ></script>
)}
