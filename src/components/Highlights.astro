---
import { highlights } from '../lib/site';
import { HighlightsRail } from './react/HighlightsRail';
import SectionTitle from './SectionTitle.astro';
---

<section
  aria-labelledby="highlights-title"
  class="page-shell mx-auto max-w-[34.375rem] py-8 sm:py-10"
>
  <div class="mb-6">
    <SectionTitle id="highlights-title" eager>
      Highlights
    </SectionTitle>
  </div>
  <HighlightsRail client:idle highlights={highlights} />
</section>
