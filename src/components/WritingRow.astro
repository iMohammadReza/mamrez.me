---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  link: string;
  date: string;
  summary: string;
  image?: string;
}

const { title, link, summary, image } = Astro.props;
const description = summary.length > 140 ? `${summary.slice(0, 137).trimEnd()}…` : summary;
---

<a
  href={link}
  target="_blank"
  rel="noreferrer noopener"
  class="group focus-visible:ring-ink focus-visible:ring-offset-canvas border-highlight-line relative grid grid-cols-[4.25rem_minmax(0,1fr)] items-start gap-3 border-b py-4 pr-11 outline-none focus-visible:ring-1 focus-visible:ring-offset-4 sm:grid-cols-[5rem_minmax(0,1fr)_auto] sm:items-center sm:gap-4 sm:pr-0"
>
  <span class="bg-highlight relative h-14 overflow-hidden rounded-[0.8rem] sm:h-16">
    {image ? (
      <Image
        src={image}
        alt=""
        width={80}
        height={64}
        densities={[1, 2, 3]}
        format="avif"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover grayscale transition-[filter,opacity] duration-300 group-hover:grayscale-0"
      />
    ) : (
      <span aria-hidden="true" class="absolute inset-0 grid place-items-center">
        <span class="font-hand text-ink-muted text-2xl leading-none">{title.charAt(0)}</span>
      </span>
    )}
    <span class="ring-highlight-line pointer-events-none absolute inset-0 rounded-[inherit] ring-1 ring-inset"></span>
  </span>
  <span class="min-w-0">
    <span class="block text-sm leading-5 font-[500] tracking-[-0.0064em] transition-opacity duration-200 group-hover:opacity-70">
      {title}
    </span>
    <span class="text-ink-muted mt-1 block max-w-md text-sm leading-5 font-[460] tracking-[-0.0064em]">
      {description}
    </span>
  </span>
  <span class="text-ink-muted absolute top-1/2 right-0 flex -translate-y-1/2 items-center sm:static sm:translate-y-0">
    <span class="group-hover:bg-highlight group-hover:text-ink flex size-10 items-center justify-center rounded-full transition-colors duration-200 sm:size-9">
      <span aria-hidden="true" class="block size-4 overflow-hidden">
        <span class="arrow-swap flex h-full w-[200%]">
          <svg viewBox="0 0 16 16" class="size-4 shrink-0" fill="none">
            <path
              d="M3 8h9.5M8.5 4 12.5 8l-4 4"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.3"
            ></path>
          </svg>
          <svg viewBox="0 0 16 16" class="size-4 shrink-0" fill="none">
            <path
              d="M3 8h9.5M8.5 4 12.5 8l-4 4"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.3"
            ></path>
          </svg>
        </span>
      </span>
    </span>
  </span>
</a>

<style>
  .arrow-swap {
    transform: translateX(-50%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group:hover .arrow-swap,
  .group:focus-visible .arrow-swap {
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow-swap {
      transition: none;
    }
  }
</style>
