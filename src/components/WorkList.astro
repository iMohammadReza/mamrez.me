---
import { work } from '../lib/site';
import SectionTitle from './SectionTitle.astro';
import Reveal from './Reveal.astro';
---

<section aria-labelledby="work-title" class="page-shell mx-auto max-w-[34.375rem] py-8 sm:py-10">
  <div class="mb-4">
    <SectionTitle id="work-title">Work</SectionTitle>
  </div>
  <div class="border-highlight-line flex flex-col border-t">
    {work.map((job, i) => (
      <Reveal
        as="article"
        delay={i * 0.06}
        class="border-highlight-line grid grid-cols-[1fr_auto] items-start gap-5 border-b py-4"
      >
        <div class="min-w-0">
          <h3 class="text-sm leading-5 font-[500] tracking-[-0.0064em]">
            {job.href ? (
              <a
                href={job.href}
                target="_blank"
                rel="noreferrer noopener"
                class="group inline-flex items-center gap-1.5 transition-opacity duration-200 hover:opacity-70"
              >
                {job.company}
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  class="text-ink-muted group-hover:text-ink size-3 transition-[color,transform] duration-300 ease-(--ease-out-expo) group-hover:translate-x-px group-hover:-translate-y-px"
                  fill="none"
                >
                  <path
                    d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.4"
                  />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ) : (
              job.company
            )}
          </h3>
          <p class="text-ink-muted mt-1 text-sm leading-5 font-[460] tracking-[-0.0064em]">
            {job.role}
          </p>
        </div>
        <p class="text-ink-muted pt-0.5 text-right text-sm leading-5 font-[460] tracking-[-0.0064em]">
          {job.start}—{job.end}
        </p>
      </Reveal>
    ))}
  </div>
</section>
